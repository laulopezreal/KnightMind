# Optional: load this file for local config (e.g. copy to .env).
# The API loads .env from services/api when starting.

# --- Stockfish (separate service) ---
# When set, the API calls this URL instead of spawning Stockfish locally.
# Run the Stockfish service: cd services/stockfish && uvicorn main:app --port 8001
STOCKFISH_SERVICE_URL=http://localhost:8001

# --- Stockfish (local binary, used only when STOCKFISH_SERVICE_URL is unset) ---
# Path to Stockfish binary. Default: "stockfish" (must be on PATH).
# STOCKFISH_PATH=stockfish
# STOCKFISH_DEPTH=12
# STOCKFISH_MOVETIME_MS=200

# --- API ---
# Comma-separated origins allowed for CORS (e.g. local frontend).
# KNIGHTMIND_CORS_ORIGINS=http://localhost:5173
# Database URL. Default: sqlite:///./knightmind.db
# DATABASE_URL=sqlite:///./knightmind.db
# Disable the in-process puzzle generation worker (e.g. for separate worker process).
# KNIGHTMIND_WORKER_DISABLED=false
