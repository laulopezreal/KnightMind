# ============================================================================
# KnightMind API - systemd service template (Docker Compose)
# ============================================================================
# Current claw-home live stack is managed directly from:
#   /home/lauureal/apps/knightmind
#
# This file is a template only. Do not install or enable it on claw-home without
# first reading OPERATIONS.md and taking a fresh DB backup.
#
# If deliberately installing:
#   cp deploy/knightmind-api.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now knightmind-api
#
# Logs:
#   journalctl -u knightmind-api -f
# ============================================================================

[Unit]
Description=KnightMind API (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/lauureal/apps/knightmind
# --env-file is required: compose only auto-loads a file literally named
# ".env" for ${POSTGRES_*} interpolation, and this project uses .env.docker.
ExecStart=/usr/bin/docker compose --env-file /home/lauureal/apps/knightmind/.env.docker up -d
ExecStop=/usr/bin/docker compose --env-file /home/lauureal/apps/knightmind/.env.docker down
ExecReload=/usr/bin/docker compose --env-file /home/lauureal/apps/knightmind/.env.docker up -d --build api
TimeoutStartSec=120

# Restart policy handled by docker compose (restart: unless-stopped),
# but systemd will bring it back after full host reboot.

[Install]
WantedBy=multi-user.target
