# Live path: /home/lauureal/apps/knightmind/deploy/public-caddy/Caddyfile
# Live container: knightmind-public-caddy
# Live domain: api.guessme.world
#
# Use this template only if deliberately migrating back to a host/system Caddy.
# Keep the same public API hostname unless Lau explicitly approves a domain move.
# ============================================================================

api.guessme.world {
	bind 65.108.67.53

	# Reverse proxy to the API published on the host by the KnightMind Compose stack.
	reverse_proxy 127.0.0.1:8000

	# Request logging
	log {
		output file /var/log/caddy/knightmind-api.log {
			roll_size 50MiB
			roll_keep 5
		}
	}

	# Security headers
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none';"
		-Server
	}
}
