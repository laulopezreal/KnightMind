# ============================================================================
# KnightMind – Environment Variables
# ============================================================================
# Copy this file:  cp .env.example .env.docker
# Then edit .env.docker with your actual values.
# ============================================================================

# --- Postgres (used by docker-compose) ---
POSTGRES_DB=knightmind
POSTGRES_USER=knightmind
POSTGRES_PASSWORD=knightmind_dev
POSTGRES_PORT=5432

# --- API ---
# DATABASE_URL is set automatically by docker-compose.
# Set this manually if running outside Docker. The API fails fast at startup
# when DATABASE_URL is unset (no more silent SQLite fallback).
# DATABASE_URL=postgresql+psycopg://knightmind:change_me@localhost:5432/knightmind

# Local development only: opt in to a local SQLite database
# (sqlite:///./knightmind.db) instead of setting DATABASE_URL.
# Never enable this in production — the SQLite file is ephemeral.
# KNIGHTMIND_DEV_SQLITE=1

# Comma-separated origins allowed for CORS.
# Local dev:   http://localhost:5173
# Production:  https://guessme.world,https://www.guessme.world
KNIGHTMIND_CORS_ORIGINS=http://localhost:5173

# --- Stockfish ---
# Docker sets this automatically to /usr/games/stockfish.
# Only override if running outside Docker.
# STOCKFISH_PATH=/usr/games/stockfish
STOCKFISH_DEPTH=12
# Alternative: limit by time per position (ms).
# STOCKFISH_MOVETIME_MS=200

# --- Puzzle quality / stability confirmation ---
# Puzzles are found by a shallow scan at STOCKFISH_DEPTH, then RE-ANALYZED at a
# deeper depth before being accepted. A candidate is kept only if, at the
# confirm depth, its swing still clears SWING_THRESHOLD, the solution stays
# stable, and the best move beats the next non-equivalent move by at least
# PUZZLE_UNIQUENESS_MARGIN (so the puzzle is not a toss-up). The deeper the
# confirm depth, the higher the quality but the slower generation.
# Guard: the confirm depth is clamped up to STOCKFISH_DEPTH if set lower.
# Default: STOCKFISH_DEPTH + 6.
# STOCKFISH_CONFIRM_DEPTH=18
# Minimum swing (pawns) for a move to count as a blunder. Default 2.0.
# SWING_THRESHOLD=2.0
# Max eval gap (pawns) for a move to be an equally-good alternative (all such
# moves are accepted as correct). Default 0.3.
# PUZZLE_EQUIV_TOLERANCE=0.3
# Minimum pawn advantage the solution must hold over the next NON-equivalent
# move for the puzzle to have a clearly-superior idea. Default 0.5.
# PUZZLE_UNIQUENESS_MARGIN=0.5

# --- Worker ---
# Set to "true" to disable the in-process puzzle generation worker.
# KNIGHTMIND_WORKER_DISABLED=false

# --- Deployment metadata (set at build/deploy time) ---
# GIT_SHA=abc1234
# BUILD_TIME=2025-01-01T00:00:00Z

# --- API port (host-side mapping) ---
API_PORT=8000
