# ============================================================================
# KnightMind – Environment Variables
# ============================================================================
# Copy this file:  cp .env.example .env.docker
# Then edit .env.docker with your actual values.
# ============================================================================

# --- Postgres (used by docker-compose) ---
POSTGRES_DB=knightmind
POSTGRES_USER=knightmind
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# --- API ---
# DATABASE_URL is set automatically by docker-compose.
# Only set this manually if running outside Docker.
# DATABASE_URL=postgresql+psycopg://knightmind:change_me@localhost:5432/knightmind

# Comma-separated origins allowed for CORS.
# Local dev:   http://localhost:5173
# Production:  https://knightmind.dev,https://www.knightmind.dev
KNIGHTMIND_CORS_ORIGINS=http://localhost:5173

# --- Stockfish ---
# Docker sets this automatically to /usr/games/stockfish.
# Only override if running outside Docker.
# STOCKFISH_PATH=/usr/games/stockfish
STOCKFISH_DEPTH=12
# Alternative: limit by time per position (ms).
# STOCKFISH_MOVETIME_MS=200

# --- Worker ---
# Set to "true" to disable the in-process puzzle generation worker.
# KNIGHTMIND_WORKER_DISABLED=false

# --- Deployment metadata (set at build/deploy time) ---
# GIT_SHA=abc1234
# BUILD_TIME=2025-01-01T00:00:00Z

# --- API port (host-side mapping) ---
API_PORT=8000
