# ============================================================================
# KnightMind – Environment Variables
# ============================================================================
# Copy this file:  cp .env.example .env.docker
# Then edit .env.docker with your actual values.
# ============================================================================

# --- Postgres (used by docker-compose) ---
POSTGRES_DB=knightmind
POSTGRES_USER=knightmind
POSTGRES_PASSWORD=knightmind_dev
POSTGRES_PORT=5432

# --- API ---
# DATABASE_URL is set automatically by docker-compose.
# Set this manually if running outside Docker. The API fails fast at startup
# when DATABASE_URL is unset (no more silent SQLite fallback).
# DATABASE_URL=postgresql+psycopg://knightmind:change_me@localhost:5432/knightmind

# --- Connection pool ---
# Ceiling is POOL_SIZE + MAX_OVERFLOW = 50, deliberately a little ABOVE anyio's
# 40-token threadpool rather than equal to it: blocking `def` handlers consume
# those 40 tokens, but asyncio.to_thread users (/engine/eval, the Chess.com
# import, the worker, the hourly cleanup) dispatch to asyncio's own executor and
# consume none, so ~10 more sessions are the realistic worst case on top. See
# the reasoning in services/api/db.py before changing either number.
# KNIGHTMIND_DB_POOL_SIZE=10
# KNIGHTMIND_DB_MAX_OVERFLOW=40

# Comma-separated origins allowed for CORS.
# Local dev:   http://localhost:5173
# Production:  https://guessme.world,https://www.guessme.world
KNIGHTMIND_CORS_ORIGINS=http://localhost:5173

# --- Stockfish ---
# Docker sets this automatically to /usr/games/stockfish.
# Only override if running outside Docker.
# STOCKFISH_PATH=/usr/games/stockfish
STOCKFISH_DEPTH=12
# Engine process tuning. THREADS/HASH_MB are passed to Stockfish itself;
# MULTIPV>1 is what lets a position report equally-good alternatives.
# STOCKFISH_THREADS=1
# STOCKFISH_HASH_MB=16
# STOCKFISH_MULTIPV=1
# Concurrency and timeouts around the engine pool. MAX_CONCURRENCY bounds how
# many engine processes run at once; EVAL_TIMEOUT_S caps a single evaluation and
# ACQUIRE_TIMEOUT_S caps how long a request waits for a free engine.
# STOCKFISH_MAX_CONCURRENCY=2
# STOCKFISH_EVAL_TIMEOUT_S=30
# STOCKFISH_ACQUIRE_TIMEOUT_S=60

# --- Puzzle quality / stability confirmation ---
# Puzzles are found by a shallow scan at STOCKFISH_DEPTH, then RE-ANALYZED at a
# deeper depth before being accepted. A candidate is kept only if, at the
# confirm depth, its swing still clears SWING_THRESHOLD, the solution stays
# stable, and the best move beats the next non-equivalent move by at least
# PUZZLE_UNIQUENESS_MARGIN (so the puzzle is not a toss-up). The deeper the
# confirm depth, the higher the quality but the slower generation.
# Guard: the confirm depth is clamped up to STOCKFISH_DEPTH if set lower.
# Default: STOCKFISH_DEPTH + 6.
# STOCKFISH_CONFIRM_DEPTH=18
# Minimum swing (pawns) for a move to count as a blunder. Default 2.0.
# SWING_THRESHOLD=2.0
# Max eval gap (pawns) for a move to be an equally-good alternative (all such
# moves are accepted as correct). Default 0.3.
# PUZZLE_EQUIV_TOLERANCE=0.3
# Minimum pawn advantage the solution must hold over the next NON-equivalent
# move for the puzzle to have a clearly-superior idea. Default 0.5.
# PUZZLE_UNIQUENESS_MARGIN=0.5

# --- Puzzle generation scope ---
# Which plies of a game are scanned for blunders, and how many plies of the
# solution line are stored. Widening the range multiplies engine time per game.
# MAX_PLIES_START=8
# MAX_PLIES_END=80
# PUZZLE_PV_MAX_PLIES=6

# --- Concurrency ---
# In-flight cap on /engine/eval, independent of the rate limit below: the limit
# bounds requests per window, this bounds simultaneous engine work.
# ENGINE_EVAL_MAX_CONCURRENCY=4

# --- Rate limits (per principal: the account when auth is on, else client IP) ---
# Where limiter state lives. "memory" (default) keeps one window per process --
# correct for a single uvicorn worker, and wrong for more than one, since each
# would keep its own window and the effective limit would multiply by the worker
# count. "postgres" shares it. The deployed API sets postgres.
# KNIGHTMIND_RATE_LIMIT_STORE=memory
#
# Each route reads RATE_LIMIT_<NAME> for requests-per-window and
# RATE_LIMIT_<NAME>_WINDOW for the window in seconds (default 60). Setting a
# limit to 0 disables that limiter entirely.
# RATE_LIMIT_ENGINE_EVAL=30
# RATE_LIMIT_OPENINGS_BASELINE=60
# RATE_LIMIT_RATINGS_SNAPSHOT=10
# RATE_LIMIT_IMPORT_CHESSCOM=5
# RATE_LIMIT_PUZZLES_GENERATE=5
# RATE_LIMIT_DIAGNOSE=5

# --- Ratings ---
# Floor on how often an automatic ratings snapshot may fire, in seconds.
# RATINGS_AUTO_SNAPSHOT_MIN_INTERVAL_SECONDS=3600

# --- Worker ---
# The worker runs as its own compose service. These two flags are NOT
# interchangeable, and /ops/health reports differently for each:
#
#   EXTERNAL  the worker runs elsewhere. The API does not start one, and reports
#             the worker's liveness from the heartbeat rows it writes. This is
#             what the API service sets.
#   DISABLED  there is no worker in this deployment at all. The API does not
#             start one and does not judge health on it. Using this where
#             EXTERNAL is meant makes a dead queue look healthy.
#
# KNIGHTMIND_WORKER_EXTERNAL=false
# KNIGHTMIND_WORKER_DISABLED=false
#
# Identifies the worker process in worker_heartbeats. Defaults to the container
# hostname, so each replica gets its own row instead of overwriting one.
# KNIGHTMIND_WORKER_ID=

# --- AI diagnosis ---
# Written explanations on each diagnosed mistake. The rules-based cause,
# patterns and training focus all work without this; only the prose needs it.
# Absent or empty means rules-only — the API starts normally either way, since
# the key is read at call time, never at startup.
# ANTHROPIC_API_KEY=sk-ant-...
#
# Ships ON. Set to 0/false/no/off for a complete kill switch: no model call, no
# audit row, diagnosis falls back to rules.
# KNIGHTMIND_AI_DIAGNOSIS=1
#
# Daily ceilings, counted from the audit log. The per-user cap bounds one
# backfill; the global cap is the backstop against a runaway loop.
# KNIGHTMIND_AI_DAILY_CAP_USER=500
# KNIGHTMIND_AI_DAILY_CAP_GLOBAL=1000
#
# Prompts and responses are kept for incident review, then swept by the
# session-cleanup loop.
# KNIGHTMIND_AI_AUDIT_RETENTION_DAYS=30
#
# Ships OFF, unlike diagnosis above. Naming overwrites puzzle_stats.title — a
# string users already see — so the first run is a deliberate one. With it
# unset every puzzle still gets a name, composed from its own position, and no
# model call is made. Set to 1 to let the model name puzzles instead.
# KNIGHTMIND_AI_NAMING=0
#
# Naming's own daily ceilings, separate from the diagnosis caps above. A bulk
# naming pass runs hundreds of calls in a row and must not be able to spend the
# allowance that keeps per-page diagnosis working.
# KNIGHTMIND_AI_NAMING_CAP_USER=500
# KNIGHTMIND_AI_NAMING_CAP_GLOBAL=1000

# --- Auth / multi-tenancy (rollout flags, both default OFF) ---
# OFF is single-user behaviour: no bearer token is required and ownership
# checks are not enforced. Turning this ON makes every per-username route
# require a valid JWT and reject requests for another user's data. Do not flip
# it before KNIGHTMIND_JWT_SECRET is set and accounts exist -- with the secret
# unset, callers that require auth fail closed.
# KNIGHTMIND_REQUIRE_AUTH=false
#
# Symmetric secret for HS256. NO DEFAULT, deliberately: issuing or verifying a
# token raises when it is unset, rather than falling back to something guessable.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# KNIGHTMIND_JWT_SECRET=
#
# Access-token lifetime in minutes. Default 60.
# KNIGHTMIND_JWT_TTL_MIN=60
#
# Independent of the above: strips solution fields from puzzle responses so the
# answer is not sitting in the payload before the user has attempted it.
# Reviews are server-verified either way, so this changes what the client can
# see, not what it can claim.
# KNIGHTMIND_STRIP_PUZZLE_SOLUTIONS=false
#
# The resolution gate: withholds a puzzle's REVEALING fields -- nickname,
# motif, diagnosis prose, queue-reason pattern -- until that puzzle has been
# attempted in its current exposure. Provenance ("12 Mar . Sicilian . move 18")
# is always served in their place, so nothing renders blank.
#
# Distinct from the flag above: that one hides the SOLUTION, this one hides the
# things that describe the solution. A name like "Bishop Had Bigger Plans"
# hands over the tactic as surely as the move does.
#
# Per exposure, not lifetime: a puzzle re-closes when it next comes due, or
# every spaced-repetition repeat attempt would be pre-spoiled by the nickname
# earned on the previous one.
# Withholds revealing fields (nickname, motif, diagnosis) for unresolved puzzles.
# Intent overrides in §5 shipped via #396/#397, so the precondition is met.
# ON by default in docker-compose.yml; unset here so the local dev default is
# set there. Flip this only for targeted testing.
# KNIGHTMIND_RESOLUTION_GATE=true

# --- Ops endpoints ---
# Pins /ops access to a single tailnet login (e.g. owner@github). Unset means
# any tailnet identity that reaches the endpoint is accepted, so set this on a
# tailnet with more than one member.
# KNIGHTMIND_OPS_TAILNET_USER=

# --- Egress proxy (deploy/egress-proxy, its own container) ---
# PROXY_LISTEN_HOST=172.18.0.1
# PROXY_LISTEN_PORT=8899

# --- Deployment metadata (set at build/deploy time) ---
# GIT_SHA=abc1234
# BUILD_TIME=2025-01-01T00:00:00Z

# --- API port (host-side mapping) ---
API_PORT=8000
