# Operator build config for the Ops board (see docs/ops-access.md).
# Copy to .env.ops and build/run with it ONLY on a tailnet device:
#   cp apps/web/.env.ops.example apps/web/.env.ops
#   npm run dev -- --mode ops      # or: vite build --mode ops
#
# NEVER set these in the public Cloudflare Pages build — that would ship the Ops
# route to the public bundle. The public build leaves VITE_ENABLE_OPS unset, so
# /ops redirects home and the Ops chunk is never emitted.

# Enable the /ops route in this build.
VITE_ENABLE_OPS=true

# Point the app at the tailnet-served API (from `tailscale serve` — see
# deploy/tailscale-serve-ops.sh). Use your node's MagicDNS name.
VITE_API_BASE=https://claw-home.your-tailnet.ts.net
